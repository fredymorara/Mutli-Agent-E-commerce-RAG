# Copy to .env and fill in values from your own AWS account.
# .env is git-ignored — never commit real resource IDs or credentials.
#
# Most infrastructure values (DynamoDB tables, S3 buckets, S3 Vector indexes,
# IAM role, log group) are resolved automatically from CloudFormation exports
# by config.py. Only the values below, created outside the stack, need to be set.

# Region / stack name used by config.py to find CloudFormation exports
AWS_REGION=us-east-1
PROJECT_NAME=udacity-agentcore

# Bedrock Knowledge Base IDs (created in the AWS Console, one per policy domain)
RETURNS_KB_ID=REPLACE_WITH_RETURNS_KB_ID
SHIPPING_KB_ID=REPLACE_WITH_SHIPPING_KB_ID
WARRANTY_KB_ID=REPLACE_WITH_WARRANTY_KB_ID

# Printed by `python src/agent_orchestrator.py deploy`
GUARDRAIL_ID=REPLACE_WITH_GUARDRAIL_ID
GUARDRAIL_VERSION=1
AGENTCORE_RUNTIME_ARN=REPLACE_WITH_RUNTIME_ARN

# Optional: override the CloudWatch log group derived from PROJECT_NAME
# AGENT_LOG_GROUP=/aws/bedrock/agentcore/udacity-agentcore
